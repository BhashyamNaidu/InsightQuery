# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Used by the app (read/write role, for ingestion + query_log writes)
DATABASE_URL=postgresql+psycopg://insightquery:insightquery@localhost:5432/insightquery
# Dedicated read-only role used ONLY for executing validated NL-to-SQL queries.
# Created by scripts/init_db_roles.sql — must have SELECT-only grants.
READONLY_DATABASE_URL=postgresql+psycopg://insightquery_readonly:insightquery_readonly@localhost:5432/insightquery

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_OUTPUT_TOKENS=1024

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SQL_ROW_LIMIT=200
SQL_STATEMENT_TIMEOUT_MS=5000
API_PORT=8000
