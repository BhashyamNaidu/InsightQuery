# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Port 5433, not 5432: docker-compose.yml maps the db container to host port 5433
# to avoid colliding with a native/local PostgreSQL install that may already be
# using 5432 on your machine. See the comment in docker-compose.yml.
# Used by the app (read/write role, for ingestion + query_log writes)
DATABASE_URL=postgresql+psycopg://insightquery:insightquery@localhost:5433/insightquery
# Dedicated read-only role used ONLY for executing validated NL-to-SQL queries.
# Created by scripts/init_db_roles.sql — must have SELECT-only grants.
READONLY_DATABASE_URL=postgresql+psycopg://insightquery_readonly:insightquery_readonly@localhost:5433/insightquery

# --- LLM (see docs/LLM_STRATEGY.md) ---
# "ollama": free, local, no API key — requires Ollama installed and running
# (https://ollama.com) with the model below pulled: `ollama pull llama3.2:3b`.
# "anthropic": requires ANTHROPIC_API_KEY, paid, higher quality output.
# "none": disables LLM features; deterministic analytics/RAG retrieval still work.
LLM_PROVIDER=ollama
LLM_MAX_OUTPUT_TOKENS=1024

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SQL_ROW_LIMIT=200
SQL_STATEMENT_TIMEOUT_MS=5000
API_PORT=8000
